[node name="Maria" parent="." unique_id=88952096 instance=ExtResource("12_2xutp")]
position = Vector2(382, 567)
nombre_npc = "Maria"
dialogo = "Hola... No te había visto antes por aquí.
¿Cómo te llamas?
¿Steve? Mucho gusto.
¿Me estás diciendo que no recuerdas nada de tu pasado?
Cuando comenzó el desastre, mi familia y yo intentamos escapar.
Una de esas plantas mutantes nos encontró.
Yo conseguí sobrevivir, pero mi familia no.
Por favor, Steve... ten cuidado ahí fuera."

[node name="Marcus" parent="." unique_id=1064914055 instance=ExtResource("12_2xutp")]
position = Vector2(1065, 561)
nombre_npc = "Marcus"
dialogo = "¡Alto! ¿Quién eres?
¿Steve? Nunca te había visto por aquí.
¿Perdiste la memoria? Qué extraño...
Cuando comenzó el desastre, una planta mutante atacó a mi mejor amigo.
Intenté salvarlo, pero no pude.
Desde entonces protejo este refugio.
Puedes quedarte, pero no causes problemas.
Y ten cuidado ahí fuera, Steve."

[node name="Elena" parent="." unique_id=1747372533 instance=ExtResource("12_2xutp")]
position = Vector2(702, 561)
nombre_npc = "Elena"
dialogo = "Espera... Tu rostro me resulta familiar.
¿Dijiste que te llamas Steve?
¿Despertaste en un laboratorio sin recuerdos?
Espera un momento...
tu y yo heramos compañeros antes del desastre, trabajábamos con plantas experimentales.
Algo salió mal y comenzaron los ataques.
Busca las notas de investigación, Steve.
Tal vez recuerdes quién eras realmente.
Y si encuentras algo del Proyecto Edén, avísame.
"

